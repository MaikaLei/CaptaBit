{
  "name": "captabit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.local.jsonc",
    "db:migrate": "wrangler d1 migrations apply captabit-local --local --config wrangler.local.jsonc",
    "admin:create": "node scripts/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/worker/index.js && node --check public/app.js",
    "deploy:check": "wrangler deploy --config wrangler.production.jsonc --dry-run",
    "deploy": "wrangler deploy --config wrangler.production.jsonc",
    "db:migrate:production": "wrangler d1 migrations apply captabit-production --remote --config wrangler.production.jsonc",
    "admin:create:production": "node scripts/create-admin.mjs --remote"
  },
  "devDependencies": {
    "miniflare": "5.20260925.0-alpha",
    "wrangler": "4.141.0"
  }
}
